# Postgres (Neon, Supabase, or local docker). DIRECT_URL is the non-pooled URL;
# set it equal to DATABASE_URL if you don't use a pooler.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pcon"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pcon"

# Auth.js — generate a secret with: npx auth secret
AUTH_SECRET=""
# Google OAuth client (console.cloud.google.com → Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Needed when self-hosting behind a proxy (not needed on Vercel).
# AUTH_TRUST_HOST=true

# Only emails on this domain can sign in.
ALLOWED_EMAIL_DOMAIN="nitjsr.ac.in"

# Seeded by `npm run db:seed` (comma-separated). Use your own college email.
SEED_ADMIN_EMAILS=""
SEED_OWNER_EMAILS=""

# Database tests (npm test) wipe every table in this database, so use a separate
# one whose name contains "test". Leave empty to skip the database tests.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pcon_test"
