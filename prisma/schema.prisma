generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Permission level. Higher levels include everything lower levels can do.
enum Role {
  MEMBER
  ADMIN
  OWNER
}

// ---------- Auth.js tables (shape required by @auth/prisma-adapter) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)

  accounts       Account[]
  sessions       Session[]
  authorProfiles BlogAuthor[]
  eventsCreated  Event[]
  teamMember     TeamMember?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Site content ----------

model BlogCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  hue       Int      @default(160)
  createdAt DateTime @default(now()) @map("created_at")

  blogs Blog[]

  @@map("blog_categories")
}

model BlogAuthor {
  id        Int      @id @default(autoincrement())
  memberId  String?  @map("member_id")
  name      String
  roleTitle String   @map("role_title")
  bio       String   @default("")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")

  member User?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  blogs  Blog[]

  @@map("blog_authors")
}

model Blog {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  title           String
  excerpt         String
  content         String
  coverImageUrl   String?   @map("cover_image_url")
  coverImageAlt   String?   @map("cover_image_alt")
  categoryId      Int       @map("category_id")
  authorId        Int       @map("author_id")
  status          String    @default("draft") // 'draft' | 'published'
  isFeatured      Boolean   @default(false) @map("is_featured")
  readTimeMinutes Int       @default(1) @map("read_time_minutes")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   BlogAuthor   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt(sort: Desc)], map: "idx_blogs_status_published")
  @@index([categoryId], map: "idx_blogs_category")
  @@map("blogs")
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  location        String?
  posterUrl       String?
  registrationUrl String?
  startDate       DateTime
  endDate         DateTime

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}

/// Who appears on the members page. Separate from `role`: being on the team
/// is not the same as having admin rights.
model TeamMember {
  id           String   @id @default(cuid())
  name         String
  studentId    String?  @unique
  photo        String?
  batch        Int
  position     String?
  designation  String?
  domain       String?
  github       String?
  linkedin     String?
  portfolio    String?
  email        String?
  order        Int      @default(0)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  specializations MemberSpecialization[]

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?  @unique

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([isActive, order])
  @@index([batch])
  @@index([studentId])
}

model MemberSpecialization {
  id           String     @id @default(cuid())
  teamMemberId String
  name         String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([teamMemberId, name])
  @@index([teamMemberId])
}

// ─────────────────────────────────────────────────────────────
//  Achievements (/achievements) and Hall of Fame (/hall-of-fame)
// ─────────────────────────────────────────────────────────────

/// A club achievement at an outside competition (ICPC regionals, national
/// hackathons). Shown on /achievements.
model Achievement {
  id        String  @id @default(cuid())
  /// Stable key, used by the seed so re-running it never duplicates rows.
  slug      String  @unique
  title     String
  organiser String
  year      Int
  /// Optional free-text dates, e.g. "22–23 Dec 2025".
  dates     String?
  /// "ICPC" | "Hackathon" | "Other" (validated in lib/validation.ts).
  kind      String
  /// Short badge text, e.g. "Winner" or "Rank 54".
  result    String
  /// Badge colour: "winner" | "runner-up" | "finalist" | "rank".
  tier      String
  /// One line of context, e.g. "1st among all NITs".
  highlight String?
  imageUrl  String?
  imageAlt  String?
  /// The one spotlighted at the top of the page.
  featured  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
  @@map("achievements")
}

/// Results of an event the club ran. Shown on /hall-of-fame.
model HallOfFameEntry {
  id      String   @id @default(cuid())
  slug    String   @unique
  event   String
  /// Calendar day the event was held.
  date    DateTime @db.Date
  /// "Contest" | "Hackathon" | "Quiz" | "Other"
  kind    String
  summary String?
  /// Results post or standings.
  link    String?

  placements HallOfFamePlacement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("hall_of_fame_entries")
}

/// A podium place (rank 1–3) or a special mention (rank null) in a Hall of Fame entry.
model HallOfFamePlacement {
  id      String          @id @default(cuid())
  entry   HallOfFameEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String
  /// 1, 2 or 3 for the podium; null for a special mention.
  rank    Int?
  name    String
  /// Roll number, e.g. "2025UGCS010".
  roll    String?
  /// Named prize for a special mention, e.g. "Best UI/UX".
  award   String?
  /// Members, for team events.
  team    String[]        @default([])
  /// Display order among the mentions.
  order   Int             @default(0)

  @@index([entryId])
  @@map("hall_of_fame_placements")
}
